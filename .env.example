# Quant Prep AI local development environment
#
# QP-001 only defines placeholders. Concrete services and values are added in
# later roadmap issues.

APP_ENV=local

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Frontend
WEB_HOST=127.0.0.1
WEB_PORT=3000
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Set to true outside `next dev` if you want AI cache hit/miss badges in the practice UI.
NEXT_PUBLIC_SHOW_AI_CACHE_STATE=

# Database
DATABASE_URL=postgresql://quant_prep:quant_prep@localhost:5432/quant_prep
TEST_DATABASE_URL=postgresql://quant_prep:quant_prep@localhost:5432/quant_prep_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Local AI provider (Ollama)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Default fallback for every chat task when a specialized model is unset.
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Optional per-task overrides (empty => use OLLAMA_CHAT_MODEL).
# Production targets when your machine can host them:
#   OLLAMA_MODEL_TUTOR=qwen3:32b
#   OLLAMA_MODEL_CODING=qwen2.5-coder:32b
#   OLLAMA_MODEL_REASONING=deepseek-r1
OLLAMA_MODEL_TUTOR=
OLLAMA_MODEL_CODING=
OLLAMA_MODEL_REASONING=
# Reserved for QP-047 semantic search (production target: nomic-embed-text).
OLLAMA_EMBEDDING_MODEL=
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# Extra repair attempts after a schema validation failure (0 disables repair).
AI_JSON_REPAIR_ATTEMPTS=1
