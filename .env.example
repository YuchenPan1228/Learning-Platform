# Quant Prep AI local development environment
#
# QP-001 only defines placeholders. Concrete services and values are added in
# later roadmap issues.

APP_ENV=local

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Frontend
WEB_HOST=127.0.0.1
WEB_PORT=3000
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Set to true outside `next dev` if you want AI cache hit/miss badges in the practice UI.
NEXT_PUBLIC_SHOW_AI_CACHE_STATE=

# Database
DATABASE_URL=postgresql://quant_prep:quant_prep@localhost:5432/quant_prep
TEST_DATABASE_URL=postgresql://quant_prep:quant_prep@localhost:5432/quant_prep_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Local file uploads (PDF import stores files here; extraction is Phase 5)
UPLOAD_DIR=data/uploads
PDF_UPLOAD_MAX_BYTES=26214400

# Ingestion source policy (QP-040). Empty allowlist = open (not enforced).
# Example: INGESTION_SOURCE_ALLOWLIST=wikipedia.org,mit.edu,.edu
INGESTION_SOURCE_ALLOWLIST=
INGESTION_USER_AGENT=QuantPrepBot/0.1 (+local-mvp)
INGESTION_ROBOTS_TIMEOUT_SECONDS=10
INGESTION_FETCH_TIMEOUT_SECONDS=30
INGESTION_MIN_EXTRACTED_CHARS=200
# Optional JS fallback (requires: pip install -e ".[playwright]" && playwright install chromium)
INGESTION_PLAYWRIGHT_ENABLED=false

# Local AI provider (Ollama)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Default fallback for every chat task when a specialized model is unset.
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Optional per-task overrides (empty => use OLLAMA_CHAT_MODEL).
# Leave empty for local speed. Heavy models like deepseek-r1 often exceed
# OLLAMA_REQUEST_TIMEOUT_SECONDS on a laptop.
# Production targets when your machine can host them:
#   OLLAMA_MODEL_GENERAL=qwen3:32b
#   OLLAMA_MODEL_CODING=qwen2.5-coder:32b
#   OLLAMA_MODEL_REASONING=deepseek-r1
OLLAMA_MODEL_GENERAL=
OLLAMA_MODEL_CODING=
OLLAMA_MODEL_REASONING=
# Reserved for QP-048 semantic search (production target: nomic-embed-text).
OLLAMA_EMBEDDING_MODEL=
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# Cap generated tokens so long-thinking models cannot spin until timeout.
OLLAMA_NUM_PREDICT=512
# JSON Schema validation retries (0 = fail fast for lower latency).
AI_JSON_REPAIR_ATTEMPTS=0
# Warm the default chat model in the background on API startup.
AI_WARMUP_ON_STARTUP=true
# Set true only if you want every specialized OLLAMA_MODEL_* preloaded too.
AI_WARMUP_SPECIALIZED_MODELS=false
