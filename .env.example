# Quant Prep AI local development environment
#
# QP-001 only defines placeholders. Concrete services and values are added in
# later roadmap issues.

APP_ENV=local

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Frontend
WEB_HOST=127.0.0.1
WEB_PORT=3000

# Database
DATABASE_URL=postgresql://quant_prep:quant_prep@localhost:5432/quant_prep

# Redis
REDIS_URL=redis://localhost:6379/0

# Local AI provider
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=

